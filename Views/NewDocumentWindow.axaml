<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:Claudel.Models"
        x:Class="Claudel.NewDocumentWindow"
        FontFamily="Segoe UI"
        Title="New Document"
        Width="900"
        Height="760"
        MinWidth="760"
        MinHeight="650"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>

        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>

        <Style Selector="ListBox">
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

    </Window.Styles>

    <Grid Margin="16"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto"
          RowSpacing="10">

        <!-- Document Type -->
        <Grid Grid.Row="0"
              ColumnDefinitions="100,*">

            <TextBlock Text="Type"
                       VerticalAlignment="Center"/>

            <ComboBox Grid.Column="1"
                      x:Name="DocumentTypeComboBox"
                      SelectionChanged="DocumentTypeComboBox_SelectionChanged">

                <ComboBoxItem Content="Book"
                              Tag="Book"/>

                <ComboBoxItem Content="Journal"
                              Tag="Journal"/>

            </ComboBox>

        </Grid>

        <!-- Title -->
        <Grid Grid.Row="1"
              ColumnDefinitions="100,*">

            <TextBlock Text="Title"
                       VerticalAlignment="Center"/>

            <TextBox Grid.Column="1"
                     x:Name="TitleTextBox"
                     PlaceholderText="Title"/>

        </Grid>

        <!-- Author -->
        <Grid Grid.Row="2"
              ColumnDefinitions="100,*">

            <TextBlock Text="Author"
                       VerticalAlignment="Top"
                       Margin="0,7,0,0"/>

            <TextBox Grid.Column="1"
                     x:Name="AuthorTextBox"
                     PlaceholderText="One author per line"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     MinHeight="70"
                     MaxHeight="100"/>

        </Grid>

        <!-- Category -->
        <Grid Grid.Row="3"
              ColumnDefinitions="100,*">

            <TextBlock Text="Category"
                       VerticalAlignment="Center"/>

            <TextBox Grid.Column="1"
                     x:Name="CategoryTextBox"
                     PlaceholderText="Category"/>

        </Grid>

        <!-- Tags -->
        <Grid Grid.Row="4"
              ColumnDefinitions="100,*">

            <TextBlock Text="Tags"
                       VerticalAlignment="Top"
                       Margin="0,7,0,0"/>

            <TextBox Grid.Column="1"
                     x:Name="TagsTextBox"
                     PlaceholderText="キリスト教, 中世, フランス"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     MinHeight="45"
                     MaxHeight="70"/>

        </Grid>

        <!-- Publication Date -->
        <Grid Grid.Row="5"
              ColumnDefinitions="100,*">

            <TextBlock Text="Publication Date"
                       VerticalAlignment="Center"/>

            <TextBox Grid.Column="1"
                     x:Name="PublicationDateTextBox"
                     PlaceholderText="yyyy-MM-dd"/>

        </Grid>

        <!-- Main content -->
        <ScrollViewer Grid.Row="6"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Spacing="12">

                <!-- Journal Search -->
                <Border x:Name="JournalSearchPanel"
                        IsVisible="False"
                        BorderThickness="1"
                        Padding="12">

                    <StackPanel Spacing="10">

                        <TextBlock Text="Journal Article Search"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                        <Grid ColumnDefinitions="*,*,Auto"
                              ColumnSpacing="8">

                            <TextBox x:Name="CrossrefTitleTextBox"
                                     PlaceholderText="Article title"/>

                            <TextBox Grid.Column="1"
                                     x:Name="CrossrefAuthorTextBox"
                                     PlaceholderText="Author"/>

                            <Button Grid.Column="2"
                                    x:Name="CrossrefSearchButton"
                                    Content="Search Crossref"
                                    Click="CrossrefSearch_Click"/>

                        </Grid>

                        <ListBox x:Name="CrossrefResultsListBox"
                                 Height="180"
                                 SelectionChanged="CrossrefResultsListBox_SelectionChanged">

                            <ListBox.ItemTemplate>

                                <DataTemplate x:DataType="models:CrossrefWork">

                                    <Border Padding="8"
                                            Margin="2"
                                            BorderThickness="1">

                                        <StackPanel Spacing="3">

                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="{Binding AuthorDisplay}"
                                                       Opacity="0.7"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="{Binding DisplayBibliography}"
                                                       Opacity="0.7"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="{Binding DOI}"
                                                       Opacity="0.55"/>

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>

                        <!-- Journal metadata -->
                        <Grid ColumnDefinitions="100,*,100,*"
                              RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="8"
                              ColumnSpacing="8">

                            <TextBlock Text="Journal"
                                       VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                                     x:Name="JournalNameTextBox"/>

                            <TextBlock Grid.Column="2"
                                       Text="Volume"
                                       VerticalAlignment="Center"/>

                            <TextBox Grid.Column="3"
                                     x:Name="VolumeTextBox"/>

                            <TextBlock Grid.Row="1"
                                       Text="Issue"
                                       VerticalAlignment="Center"/>

                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     x:Name="IssueTextBox"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       Text="Pages"
                                       VerticalAlignment="Center"/>

                            <TextBox Grid.Row="1"
                                     Grid.Column="3"
                                     x:Name="PagesTextBox"/>

                            <TextBlock Grid.Row="2"
                                       Text="DOI"
                                       VerticalAlignment="Center"/>

                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Grid.ColumnSpan="3"
                                     x:Name="DoiTextBox"/>

                        </Grid>

                    </StackPanel>

                </Border>

                <!-- Cover -->
                <Grid ColumnDefinitions="*,260"
                      ColumnSpacing="16">

                    <!-- Local cover -->
                    <StackPanel Spacing="8">

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock Text="Cover"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                                    x:Name="UploadCoverButton"
                                    Content="Upload Image"
                                    Click="UploadCover_Click"/>

                        </Grid>

                    </StackPanel>

                    <!-- Selected cover -->
                    <Border Grid.Column="1"
                            BorderThickness="1"
                            Padding="12">

                        <Grid RowDefinitions="Auto,*,Auto"
                              RowSpacing="10">

                            <TextBlock Text="Selected Cover"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>

                            <Border Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                <Image x:Name="SelectedCoverImage"
                                       Width="210"
                                       Height="300"
                                       Stretch="Uniform"/>

                            </Border>

                            <StackPanel Grid.Row="2"
                                        Spacing="4">

                                <TextBlock x:Name="SelectedCoverTitle"
                                           TextWrapping="Wrap"/>

                                <TextBlock x:Name="SelectedCoverAuthor"
                                           Opacity="0.65"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                </Grid>

            </StackPanel>

        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">

            <Button Content="Cancel"
                    Click="Cancel_Click"/>

            <Button Content="Create"
                    Click="Create_Click"/>

        </StackPanel>

    </Grid>

</Window>
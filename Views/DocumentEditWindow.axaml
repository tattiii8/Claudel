<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:Claudel.Models"
        x:Class="Claudel.DocumentEditWindow"
        Title="Edit Document"
        FontFamily="Segoe UI"
        Width="900"
        Height="900"
        MinWidth="760"
        MinHeight="700"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>

        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.65"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>

        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>

        <Style Selector="ListBox">
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

    </Window.Styles>

    <ScrollViewer>

        <StackPanel
            Margin="24"
            Spacing="6">

            <TextBlock
                Text="Edit Document"
                FontSize="17"
                FontWeight="SemiBold"
                Margin="0,0,0,12"/>

            <!-- Document Type -->

            <TextBlock
                Classes="label"
                Text="Document Type"/>

            <ComboBox
                x:Name="DocumentTypeComboBox"
                SelectionChanged="DocumentTypeComboBox_SelectionChanged">

                <ComboBoxItem
                    Content="Book"
                    Tag="Book"/>

                <ComboBoxItem
                    Content="Journal"
                    Tag="Journal"/>

            </ComboBox>

            <!-- Title -->

            <TextBlock
                Classes="label"
                Text="Title"
                Margin="0,7,0,0"/>

            <TextBox
                x:Name="TitleTextBox"/>

            <!-- Author -->

            <TextBlock
                Classes="label"
                Text="Author"
                Margin="0,7,0,0"/>

            <TextBox
                x:Name="AuthorTextBox"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                VerticalContentAlignment="Top"
                MinHeight="80"
                MaxHeight="120"
                Watermark="One author per line"/>

            <!-- Journal Search -->

            <Border
                x:Name="JournalSearchPanel"
                IsVisible="False"
                BorderThickness="1"
                Padding="12"
                Margin="0,12,0,0">

                <StackPanel
                    Spacing="6">

                    <TextBlock
                        Text="Journal Search"
                        FontSize="13"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        Classes="label"
                        Text="Crossref searches bibliographic metadata."/>

                    <TextBlock
                        Classes="label"
                        Text="Title"/>

                    <TextBox
                        x:Name="CrossrefTitleTextBox"/>

                    <TextBlock
                        Classes="label"
                        Text="Author"
                        Margin="0,4,0,0"/>

                    <TextBox
                        x:Name="CrossrefAuthorTextBox"/>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6"
                        Margin="0,4,0,0">

                        <Button
                            x:Name="CrossrefSearchButton"
                            Content="Crossref Search"
                            Click="CrossrefSearch_Click"/>

                    </StackPanel>

                    <TextBlock
                        x:Name="CrossrefStatusText"
                        FontSize="11"
                        Opacity="0.65"
                        IsVisible="False"/>

                    <ListBox
                        x:Name="CrossrefResultsListBox"
                        MaxHeight="280"
                        SelectionChanged="CrossrefResultsListBox_SelectionChanged">

                        <ListBox.ItemTemplate>

                            <DataTemplate
                                x:DataType="models:CrossrefWork">

                                <Border
                                    Padding="8"
                                    Margin="2"
                                    BorderThickness="1">

                                    <StackPanel
                                        Spacing="3">

                                        <TextBlock
                                            Text="{Binding Title}"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap"/>

                                        <TextBlock
                                            Text="{Binding AuthorDisplay}"
                                            TextWrapping="Wrap"
                                            FontSize="11"/>

                                        <TextBlock
                                            Text="{Binding JournalName}"
                                            TextWrapping="Wrap"
                                            FontSize="11"/>

                                        <TextBlock
                                            Text="{Binding DisplayPublicationDate}"
                                            FontSize="11"
                                            Opacity="0.65"/>

                                        <TextBlock
                                            Text="{Binding DisplayBibliography}"
                                            FontSize="11"
                                            Opacity="0.65"/>

                                        <TextBlock
                                            Text="{Binding DOI}"
                                            FontSize="11"
                                            Opacity="0.65"/>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </StackPanel>

            </Border>

            <!-- Journal Metadata -->

            <StackPanel
                x:Name="JournalMetadataPanel"
                IsVisible="False"
                Spacing="6"
                Margin="0,7,0,0">

                <TextBlock
                    Classes="label"
                    Text="Journal Name"/>

                <TextBox
                    x:Name="JournalNameTextBox"/>

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10">

                    <StackPanel
                        Spacing="6">

                        <TextBlock
                            Classes="label"
                            Text="Volume"/>

                        <TextBox
                            x:Name="VolumeTextBox"/>

                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Spacing="6">

                        <TextBlock
                            Classes="label"
                            Text="Issue"/>

                        <TextBox
                            x:Name="IssueTextBox"/>

                    </StackPanel>

                </Grid>

                <TextBlock
                    Classes="label"
                    Text="Pages"/>

                <TextBox
                    x:Name="PagesTextBox"/>

                <TextBlock
                    Classes="label"
                    Text="DOI"/>

                <TextBox
                    x:Name="DoiTextBox"/>

            </StackPanel>

            <!-- Category -->

            <TextBlock
                Classes="label"
                Text="Category"
                Margin="0,7,0,0"/>

            <TextBox
                x:Name="CategoryTextBox"/>

            <!-- Tags -->

            <TextBlock
                Classes="label"
                Text="Tags"
                Margin="0,7,0,0"/>

            <TextBox
                x:Name="TagsTextBox"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                VerticalContentAlignment="Top"
                MinHeight="50"
                MaxHeight="80"
                Watermark="Tags"/>

            <!-- Publication Date -->

            <TextBlock
                Classes="label"
                Text="Publication Date"
                Margin="0,7,0,0"/>

            <TextBox
                x:Name="PublicationDateTextBox"
                Watermark="yyyy-MM-dd"/>

            <!-- Cover -->

            <TextBlock
                Classes="label"
                Text="Cover"
                Margin="0,14,0,0"/>

            <Grid
                ColumnDefinitions="220,*"
                ColumnSpacing="14">

                <!-- Current cover -->

                <Border
                    Width="200"
                    Height="280"
                    BorderThickness="1"
                    HorizontalAlignment="Left">

                    <Image
                        x:Name="CoverImage"
                        Stretch="Uniform"/>

                </Border>

                <!-- Cover controls -->

                <StackPanel
                    Grid.Column="1"
                    Spacing="8">

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6">

                        <Button
                            x:Name="UploadCoverButton"
                            Content="Upload Image"
                            Click="UploadCover_Click"/>

                    </StackPanel>

                    <TextBlock
                        Text="Local Cover"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Margin="0,4,0,0"/>

                    <TextBlock
                        Text="Open Library cover search has been removed."
                        FontSize="11"
                        Opacity="0.65"
                        TextWrapping="Wrap"/>

                </StackPanel>

            </Grid>

            <!-- Progress -->

            <StackPanel
                x:Name="UploadProgressPanel"
                Spacing="4"
                Margin="0,14,0,0"
                IsVisible="False">

                <Grid
                    ColumnDefinitions="*,Auto">

                    <TextBlock
                        x:Name="UploadStatusText"
                        Text="Uploading..."
                        FontSize="11"/>

                    <TextBlock
                        x:Name="UploadProgressText"
                        Grid.Column="1"
                        Text="0%"
                        FontSize="11"/>

                </Grid>

                <ProgressBar
                    x:Name="UploadProgressBar"
                    Minimum="0"
                    Maximum="100"
                    Value="0"/>

            </StackPanel>

            <!-- Buttons -->

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="6"
                Margin="0,18,0,0">

                <Button
                    x:Name="CancelButton"
                    Content="Cancel"
                    Click="Cancel_Click"/>

                <Button
                    x:Name="SaveButton"
                    Content="Save"
                    Click="Save_Click"/>

            </StackPanel>

        </StackPanel>

    </ScrollViewer>

</Window>
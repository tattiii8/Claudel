<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Claudel.DocumentWindow"
        Title="Document"
        FontFamily="Segoe UI"
        Width="680"
        Height="540"
        MinWidth="560"
        MinHeight="440"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>

        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.55"/>
        </Style>

        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.55"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>

        <Style Selector="Button.delete">
            <Setter Property="Foreground" Value="#C62828"/>
        </Style>

        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,9"/>
        </Style>

        <Style Selector="Separator">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>

    </Window.Styles>

    <Grid
        Margin="24"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="16">

        <!-- Header -->

        <StackPanel
            Grid.Row="0"
            Spacing="4">

            <TextBlock
                x:Name="TitleTextBlock"
                FontSize="20"
                FontWeight="SemiBold"
                TextWrapping="Wrap"/>

            <TextBlock
                x:Name="AuthorTextBlock"
                FontSize="12"
                Opacity="0.55"
                TextWrapping="Wrap"/>

        </StackPanel>

        <!-- Header separator -->

        <Separator
            Grid.Row="1"/>

        <!-- Main tabs -->

        <TabControl
            Grid.Row="2">

            <!-- General -->

            <TabItem Header="General">

                <Grid
                    Margin="8,18,8,8"
                    RowDefinitions="*,Auto"
                    RowSpacing="18">

                    <!-- Metadata -->

                    <Grid
                        Grid.Row="0"
                        ColumnDefinitions="110,*"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        RowSpacing="14">

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Classes="label"
                            Text="Category"/>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            x:Name="CategoryTextBlock"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Classes="label"
                            Text="Tags"/>

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            x:Name="TagsTextBlock"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Classes="label"
                            Text="Publication Date"/>

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            x:Name="PublicationDateTextBlock"/>

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Classes="label"
                            Text="Authors"/>

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            x:Name="AuthorsTextBlock"
                            TextWrapping="Wrap"/>

                    </Grid>

                    <!-- General actions -->

                    <StackPanel
                        Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="6">

                        <Button
                            Content="Edit"
                            Classes="secondary"
                            Click="Edit_Click"/>

                        <Button
                            Content="Delete"
                            Classes="delete"
                            Click="Delete_Click"/>

                        <Button
                            Content="Close"
                            Classes="secondary"
                            Click="Close_Click"/>

                    </StackPanel>

                </Grid>

            </TabItem>

            <!-- Redmine -->

            <TabItem Header="Redmine">

                <Grid
                    Margin="8,18,8,8"
                    RowDefinitions="Auto,Auto,*,Auto"
                    RowSpacing="16">

                    <!-- Redmine header -->

                    <StackPanel
                        Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="10">

                        <Border
                            Width="36"
                            Height="36"
                            CornerRadius="6"
                            Background="#2F6DB0">

                            <TextBlock
                                Text="R"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel
                            VerticalAlignment="Center"
                            Spacing="2">

                            <TextBlock
                                Classes="section"
                                Text="Redmine"/>

                            <TextBlock
                                Classes="muted"
                                Text="Issue integration"/>

                        </StackPanel>

                    </StackPanel>

                    <!-- Redmine information -->

                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="110,*"
                        RowDefinitions="Auto,Auto,Auto"
                        RowSpacing="12">

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Classes="label"
                            Text="Project"/>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            x:Name="RedmineProjectTextBlock"
                            Text="recherche"/>

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Classes="label"
                            Text="Tracker"/>

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            x:Name="RedmineTrackerTextBlock"
                            Text="Lecture"/>

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Classes="label"
                            Text="Issue"/>

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            x:Name="RedmineIssueTextBlock"
                            Text="Not linked"/>

                    </Grid>

                    <Border
                        Grid.Row="2"/>

                    <!-- Redmine actions -->

                    <StackPanel
                        Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">

                        <Button
                            x:Name="CreateIssueButton"
                            Classes="primary"
                            Content="Redmineへ同期"
                            Click="CreateIssue_Click"/>

                        <Button
                            x:Name="LinkIssueButton"
                            Classes="secondary"
                            Content="Link Issue"
                            Click="LinkIssue_Click"/>

                        <Button
                            x:Name="OpenRedmineButton"
                            Classes="secondary"
                            Content="Open in Redmine"
                            Click="OpenRedmine_Click"/>

                        <Button
                            x:Name="UnlinkIssueButton"
                            Classes="secondary"
                            Content="Unlink"
                            Click="UnlinkIssue_Click"/>

                    </StackPanel>

                </Grid>

            </TabItem>

            <!-- Kavita -->

            <TabItem Header="Kavita">

                <Grid
                    Margin="8,18,8,8"
                    RowDefinitions="Auto,Auto,*,Auto"
                    RowSpacing="16">

                    <!-- Kavita header -->

                    <StackPanel
                        Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="10">

                        <Border
                            Width="36"
                            Height="36"
                            CornerRadius="6"
                            Background="#6A4FB3">

                            <TextBlock
                                Text="K"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel
                            VerticalAlignment="Center"
                            Spacing="2">

                            <TextBlock
                                Classes="section"
                                Text="Kavita"/>

                            <TextBlock
                                Classes="muted"
                                Text="Book / Series integration"/>

                        </StackPanel>

                    </StackPanel>

                    <!-- Kavita information -->

                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="110,*"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        RowSpacing="12">

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Classes="label"
                            Text="Library"/>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            x:Name="KavitaLibraryTextBlock"
                            Text="Not linked"/>

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Classes="label"
                            Text="Series"/>

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            x:Name="KavitaSeriesTextBlock"
                            Text="Not linked"/>

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Classes="label"
                            Text="Volume"/>

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            x:Name="KavitaVolumeTextBlock"
                            Text="Not linked"/>

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Classes="label"
                            Text="URL"/>

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            x:Name="KavitaUrlTextBlock"
                            Text="Not linked"
                            TextWrapping="Wrap"/>

                    </Grid>

                    <!-- Empty space -->

                    <Border
                        Grid.Row="2"/>

                    <!-- Kavita actions -->

                    <StackPanel
                        Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">

                        <Button
                            x:Name="LinkKavitaButton"
                            Classes="secondary"
                            Content="Kavitaへ同期"
                            Click="LinkKavita_Click"/>

                        <Button
                            x:Name="OpenKavitaButton"
                            Classes="primary"
                            Content="Kavitaで読む"
                            Click="OpenKavita_Click"/>

                    </StackPanel>

                </Grid>

            </TabItem>

        </TabControl>

        <!-- Bottom spacer -->

        <Border
            Grid.Row="3"
            Height="1"/>

    </Grid>

</Window>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Claudel"
        xmlns:models="using:Claudel.Models"
        x:Class="Claudel.MainWindow"
        x:DataType="local:MainWindow"
        FontFamily="Segoe UI"
        Title="Claudel"
        Width="1100"
        Height="700"
        MinWidth="800"
        MinHeight="500">

    <Window.Styles>

        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

    </Window.Styles>

    <Grid
        RowDefinitions="Auto,Auto,*"
        Margin="12">

        <!-- Header -->

        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            Margin="0,0,0,10">

            <StackPanel
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center">

                <TextBlock
                    Text="Claudel"
                    FontSize="17"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="Library"
                    FontSize="12"
                    Opacity="0.55"
                    VerticalAlignment="Center"/>

            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="6">

                <Button
                    Content="New Document"
                    Click="NewDocument_Click"/>

                <Button
                    Content="Settings"
                    Click="Settings_Click"/>

            </StackPanel>

        </Grid>

        <!-- Search -->

        <TextBox
            Grid.Row="1"
            x:Name="SearchTextBox"
            PlaceholderText="Search..."
            TextChanged="SearchTextBox_TextChanged"
            Margin="0,0,0,10"/>

        <!-- Documents -->

        <ListBox
            Grid.Row="2"
            x:Name="DocumentListBox"
            ItemsSource="{Binding Documents}"
            DoubleTapped="DocumentListBox_DoubleTapped">

            <ListBox.ItemsPanel>

                <ItemsPanelTemplate>

                    <WrapPanel
                        Orientation="Horizontal"/>

                </ItemsPanelTemplate>

            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>

                <DataTemplate
                    x:DataType="models:Document">

                    <Border
                        Width="150"
                        Margin="4"
                        Padding="6"
                        BorderBrush="#33000000"
                        BorderThickness="1">

                        <StackPanel
                            Spacing="6">

                            <Border
                                Width="138"
                                Height="190"
                                Background="#10000000">

                                <Image
                                    Source="{Binding CoverImage}"
                                    Stretch="Uniform"/>
                            </Border>

                            <TextBlock
                                Text="{Binding Title}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"
                                MaxHeight="36"
                                TextTrimming="CharacterEllipsis"/>

                        </StackPanel>

                    </Border>

                </DataTemplate>

            </ListBox.ItemTemplate>

        </ListBox>

    </Grid>

</Window>